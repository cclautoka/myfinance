<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_shell">

  <ImageView
    android:id="@+id/widget_hud_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription=""
    android:scaleType="fitXY" />

  <View
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:background="@drawable/widget_accent_teal" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="monospace"
      android:letterSpacing="0.14"
      android:text="◈ FINANCE / PAYLOG"
      android:textAllCaps="true"
      android:textColor="@color/widget_text_muted"
      android:textSize="9sp"
      android:textStyle="bold" />

    <ImageView
      android:id="@+id/widget_fab"
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:layout_marginTop="10dp"
      android:contentDescription="Log pay" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:fontFamily="monospace"
      android:letterSpacing="0.12"
      android:text="LOG DEPOSIT"
      android:textAllCaps="true"
      android:textColor="@color/widget_text_accent"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:fontFamily="monospace"
      android:text="Tap to open paycheque log"
      android:textColor="@color/widget_text_muted"
      android:textSize="10sp" />
  </LinearLayout>
</FrameLayout>
