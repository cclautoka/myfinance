<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_shell">

  <View
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:background="@drawable/widget_accent_teal" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:background="@drawable/widget_pay_fab">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />
    </FrameLayout>

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:letterSpacing="0.08"
      android:text="LOG PAY"
      android:textAllCaps="true"
      android:textColor="@color/widget_text_accent"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Tap to add a deposit"
      android:textColor="@color/widget_text_muted"
      android:textSize="11sp" />
  </LinearLayout>
</FrameLayout>
