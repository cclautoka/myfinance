<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_shell">

  <View
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:background="@drawable/widget_accent_violet" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:letterSpacing="0.12"
      android:text="OUR FINANCE"
      android:textAllCaps="true"
      android:textColor="@color/widget_text_muted"
      android:textSize="9sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Savings goals"
      android:textColor="@color/widget_text_accent"
      android:textSize="11sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/widget_rings_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/widget_goal1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/widget_goal1_ring"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:contentDescription="Goal ring 1" />

        <TextView
          android:id="@+id/widget_goal1_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="First $1k"
          android:textColor="@color/widget_text_primary"
          android:textSize="10sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_goal1_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="$0 / $0"
          android:textColor="@color/widget_text_muted"
          android:textSize="9sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_goal2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
          android:id="@+id/widget_goal2_ring"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:contentDescription="Goal ring 2" />

        <TextView
          android:id="@+id/widget_goal2_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="Goal"
          android:textColor="@color/widget_text_primary"
          android:textSize="10sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_goal2_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="$0 / $0"
          android:textColor="@color/widget_text_muted"
          android:textSize="9sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_goal3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/widget_goal3_ring"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:contentDescription="Goal ring 3" />

        <TextView
          android:id="@+id/widget_goal3_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="Goal"
          android:textColor="@color/widget_text_primary"
          android:textSize="10sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_goal3_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="$0 / $0"
          android:textColor="@color/widget_text_muted"
          android:textSize="9sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
