<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_shell">

  <ImageView
    android:id="@+id/widget_hud_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription=""
    android:scaleType="fitXY" />

  <View
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:background="@drawable/widget_accent_violet" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:letterSpacing="0.14"
        android:text="◈ FINANCE / GOALS"
        android:textAllCaps="true"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/widget_live_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:contentDescription="Live sync" />
    </LinearLayout>

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:fontFamily="monospace"
      android:text="RESERVE TRACKER"
      android:textColor="@color/widget_text_violet"
      android:textSize="10sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/widget_rings_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/widget_goal1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/widget_goal1_ring"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:contentDescription="Goal ring 1" />

        <TextView
          android:id="@+id/widget_goal1_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:fontFamily="monospace"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="FIRST $1K"
          android:textColor="@color/widget_text_primary"
          android:textSize="9sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_goal1_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="monospace"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="$0 / $0"
          android:textColor="@color/widget_text_muted"
          android:textSize="8sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_goal2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
          android:id="@+id/widget_goal2_ring"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:contentDescription="Goal ring 2" />

        <TextView
          android:id="@+id/widget_goal2_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:fontFamily="monospace"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="GOAL"
          android:textColor="@color/widget_text_primary"
          android:textSize="9sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_goal2_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="monospace"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="$0 / $0"
          android:textColor="@color/widget_text_muted"
          android:textSize="8sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_goal3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/widget_goal3_ring"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:contentDescription="Goal ring 3" />

        <TextView
          android:id="@+id/widget_goal3_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:fontFamily="monospace"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="GOAL"
          android:textColor="@color/widget_text_primary"
          android:textSize="9sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_goal3_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="monospace"
          android:gravity="center"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:text="$0 / $0"
          android:textColor="@color/widget_text_muted"
          android:textSize="8sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
