<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="4dp"
  android:background="@drawable/widget_bg">

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Goals"
    android:textStyle="bold"
    android:textSize="12sp"
    android:textColor="@android:color/white" />

  <LinearLayout
    android:id="@+id/widget_rings_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/widget_goal1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center_horizontal">

      <ImageView
        android:id="@+id/widget_goal1_ring"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Goal ring 1" />

      <TextView
        android:id="@+id/widget_goal1_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text="First $1k"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:singleLine="true"
        android:ellipsize="end" />

      <TextView
        android:id="@+id/widget_goal1_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text="$500 / $1000"
        android:textSize="8sp"
        android:textColor="@android:color/white"
        android:alpha="0.85"
        android:singleLine="true"
        android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/widget_goal2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingStart="6dp"
      android:paddingEnd="6dp">

      <ImageView
        android:id="@+id/widget_goal2_ring"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Goal ring 2" />

      <TextView
        android:id="@+id/widget_goal2_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text="3-month"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:singleLine="true"
        android:ellipsize="end" />

      <TextView
        android:id="@+id/widget_goal2_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text="$500 / $10200"
        android:textSize="8sp"
        android:textColor="@android:color/white"
        android:alpha="0.85"
        android:singleLine="true"
        android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/widget_goal3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center_horizontal">

      <ImageView
        android:id="@+id/widget_goal3_ring"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Goal ring 3" />

      <TextView
        android:id="@+id/widget_goal3_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text="Goal"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:singleLine="true"
        android:ellipsize="end" />

      <TextView
        android:id="@+id/widget_goal3_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text="$0 / $0"
        android:textSize="8sp"
        android:textColor="@android:color/white"
        android:alpha="0.85"
        android:singleLine="true"
        android:ellipsize="end" />
    </LinearLayout>
  </LinearLayout>

</LinearLayout>

