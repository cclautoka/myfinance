<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_shell"
  android:padding="0dp">

  <View
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:background="@drawable/widget_accent_amber" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
      android:id="@+id/widget_eyebrow"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:letterSpacing="0.12"
      android:text="OUR FINANCE"
      android:textAllCaps="true"
      android:textColor="@color/widget_text_muted"
      android:textSize="9sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Due next"
      android:textColor="@color/widget_text_accent"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_line1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="—"
      android:textColor="@color/widget_text_primary"
      android:textSize="17sp"
      android:textStyle="bold" />

    <ImageView
      android:id="@+id/widget_progress_bitmap"
      android:layout_width="match_parent"
      android:layout_height="8dp"
      android:layout_marginTop="10dp"
      android:layout_marginBottom="8dp"
      android:contentDescription="Due progress"
      android:scaleType="fitXY" />

    <TextView
      android:id="@+id/widget_line2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="—"
      android:textColor="@color/widget_text_muted"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/widget_meta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:background="@drawable/widget_badge_overdue"
      android:paddingStart="8dp"
      android:paddingTop="3dp"
      android:paddingEnd="8dp"
      android:paddingBottom="3dp"
      android:text="Updates after sync"
      android:textColor="@color/widget_text_primary"
      android:textSize="10sp"
      android:visibility="gone" />

    <ProgressBar
      android:id="@+id/widget_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
