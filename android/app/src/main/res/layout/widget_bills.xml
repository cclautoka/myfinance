<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_shell"
  android:padding="0dp">

  <ImageView
    android:id="@+id/widget_hud_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription=""
    android:scaleType="fitXY" />

  <View
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:background="@drawable/widget_accent_amber" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:letterSpacing="0.14"
        android:text="◈ FINANCE / BILLS"
        android:textAllCaps="true"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/widget_live_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:contentDescription="Live sync" />
    </LinearLayout>

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:fontFamily="monospace"
      android:text="NEXT DUE"
      android:textColor="@color/widget_amber"
      android:textSize="10sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_line1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="—"
      android:textColor="@color/widget_text_primary"
      android:textSize="18sp"
      android:textStyle="bold" />

    <ImageView
      android:id="@+id/widget_progress_bitmap"
      android:layout_width="match_parent"
      android:layout_height="10dp"
      android:layout_marginTop="10dp"
      android:layout_marginBottom="8dp"
      android:contentDescription="Due countdown"
      android:scaleType="fitXY" />

    <TextView
      android:id="@+id/widget_line2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="monospace"
      android:maxLines="1"
      android:text="—"
      android:textColor="@color/widget_text_cyan"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/widget_meta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:background="@drawable/widget_badge_overdue"
      android:fontFamily="monospace"
      android:paddingStart="8dp"
      android:paddingTop="3dp"
      android:paddingEnd="8dp"
      android:paddingBottom="3dp"
      android:text="SYNC REQUIRED"
      android:textColor="@color/widget_text_primary"
      android:textSize="9sp"
      android:visibility="gone" />

    <ProgressBar
      android:id="@+id/widget_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
