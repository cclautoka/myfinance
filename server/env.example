# NOTIFY_TO: comma-separated fallback for mail. Scheduled /v1/reminders/send prefers
# notifyRecipientEmails from the latest POST /v1/snapshot (husband/wife from Tools & alerts) when present.
NOTIFY_API_SECRET=change-me-at-least-16-characters
DATABASE_URL=postgresql://user:pass@localhost:5432/finance
NOTIFY_TO=you@example.com
RESEND_API_KEY=re_xxxxx
RESEND_FROM=Household finances <notify@yourdomain.com>
