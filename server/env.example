# Copy to `.env` in this folder. The API loads it via `load-env.mjs` even when you start Node from the repo root.
# Modern /v1 auth: SESSION_SECRET (min 16 chars) signs fm_sess_* session tokens; household devices use hk_* keys.
# NOTIFY_LEGACY_SECRET_DISABLED=1 — recommended once every client uses session and/or hk_*; legacy NOTIFY_API_SECRET bearer is rejected.
# NOTIFY_API_SECRET — only if legacy bearer is NOT disabled: one shared global secret for old clients (min 16 chars).
# APP_PUBLIC_URL or SITE_URL: recommended for partner invite / email verify / password reset / magic login links (#invite=, #verify=, #reset=, #login=).
SESSION_SECRET=change-me-another-long-random-string
NOTIFY_LEGACY_SECRET_DISABLED=1
# NOTIFY_API_SECRET=change-me-at-least-16-characters
APP_PUBLIC_URL=https://finance.solofi.cloud
# Production audit (after deploy): npm run list:households — expect only your owner email(s).
DATABASE_URL=postgresql://user:pass@localhost:5432/finance
# After setting DATABASE_URL, run: npm run db:migrate  (creates finance_state + household auth tables)
# NOTIFY_TO: optional legacy comma-separated fallback for mail when no in-app emails / snapshot recipients.
# RESEND_* or SMTP_* for outbound mail.
RESEND_API_KEY=re_xxxxx
RESEND_FROM=Household finances <notify@yourdomain.com>
# Required for production: block workbook sync until the member verifies email (403 EMAIL_NOT_VERIFIED).
EMAIL_VERIFICATION_REQUIRED=1
# Session token lifetime for fm_sess (default 365 days).
# SESSION_TOKEN_TTL_DAYS=365
