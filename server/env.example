# Required: shared secret the browser sends as Authorization: Bearer <NOTIFY_API_SECRET>
NOTIFY_API_SECRET=change-me-long-random-string

# Who receives change notifications
NOTIFY_TO=you@example.com

# CORS: comma-separated origins allowed to call POST /v1/notify from the browser.
# Example: https://finances.yourdomain.com,http://localhost:5173
# Leave empty to allow any origin (okay behind VPN; tighten for public sites).
NOTIFY_CORS_ORIGINS=

# --- Option A: Resend (https://resend.com) — simplest on Dokploy ---
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. Household <onboarding@resend.dev>
RESEND_FROM=Household finances <onboarding@resend.dev>

# --- Option B: SMTP (used only if RESEND_API_KEY is unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Household finances <noreply@yourdomain.com>
