{
  "name": "finance",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:capacitor": "CAPACITOR=true tsc -b && CAPACITOR=true vite build --mode capacitor",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "server:start": "npm --prefix server start",
    "server:db:migrate": "npm --prefix server run db:migrate",
    "server:seed:shahil": "npm --prefix server run seed:shahil",
    "server:list:households": "npm --prefix server run list:households",
    "server:create-cron-key": "npm --prefix server run create-cron-key"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.0",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource-variable/syne": "^5.2.7",
    "@tailwindcss/vite": "^4.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
